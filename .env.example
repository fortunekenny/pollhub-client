# --- API location -----------------------------------------------------------
# Leave BOTH blank for local development. vite.config.js proxies /api and /ws
# to the API on :3000, which keeps the browser origin the same so the API's
# signed cookies are stored and sent.
#
# In production the client is on its own origin and that proxy does not exist,
# so both must be absolute — otherwise they resolve against the static host,
# which serves no API and no WebSocket. Render sets these from render.yaml.
#
#   VITE_API_BASE=https://pollhub-api.onrender.com/api/v1
#   VITE_WS_URL=wss://pollhub-api.onrender.com/ws
#
# Vite inlines these at BUILD time. Changing one requires a rebuild.
VITE_API_BASE=
VITE_WS_URL=

# --- Bot check (Cloudflare Turnstile) ---------------------------------------
# The SITE key, from Cloudflare dashboard → Turnstile → your widget. It is
# public and safe to ship in the bundle; the matching SECRET key belongs on the
# API as TURNSTILE_SECRET_KEY.
#
# The two are a pair and must be set together. The API rejects every response
# with "Verification challenge failed" once it holds a secret key and no token
# reaches it — so a secret set here without this site key blocks all voting.
#
# Add the client's origin to the widget's allowed hostnames, or Cloudflare
# refuses to render it. localhost is permitted by default for development.
VITE_TURNSTILE_SITE_KEY=

# --- Web push (optional) ----------------------------------------------------
# From the Firebase console → Project settings → General → Your apps (Web).
# The VAPID key is under Cloud Messaging → Web Push certificates.
# Leave blank and the notifications card reports "not configured" rather than
# failing at runtime.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_VAPID_KEY=
