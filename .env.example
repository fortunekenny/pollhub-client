# Dev leaves these blank: vite.config.js proxies /api and /ws to the API on
# :3000, which keeps the origin the same so signed cookies work.
VITE_API_BASE=
VITE_WS_URL=

# --- Web push (optional) ----------------------------------------------------
# From the Firebase console → Project settings → General → Your apps (Web).
# The VAPID key is under Cloud Messaging → Web Push certificates.
# Leave blank and the notifications card reports "not configured" rather than
# failing at runtime.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_VAPID_KEY=
